{
  "manifest_version": 3,
  "name": "Threadly — Shared Inbox & Helpdesk for Gmail",
  "version": "1.1.0",
  "description": "Transform Gmail into a collaborative shared inbox with left-sidebar Shared Inboxes, assignment, tags, SLA timers, internal notes, and AI summarization.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:4000/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Threadly Workspace",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/AlphaRope.ttf"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
