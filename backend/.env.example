# Threadly Backend Environment Configuration

# Server Port
PORT=4000

# Google OAuth 2.0 Credentials (Optional for 24/7 Cloud Background Sync)
# To obtain these:
# 1. Visit https://console.cloud.google.com/
# 2. Create a project and configure the OAuth Consent Screen
# 3. Create an OAuth 2.0 Client ID (Web Application)
# 4. Add Authorized Redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Note: If Google OAuth credentials are not provided, Threadly operates seamlessly
# via Method 1 (Direct Chrome Extension tab bridge) with zero configuration required.
